# mock | http  (default: mock)
NEXT_PUBLIC_API_MODE=mock
# Backend (Django) manzili: brauzer uchun NEXT_PUBLIC_API_URL, server (SSR) uchun API_URL.
# Docker ichida (frontend ham konteynerda bo'lsa) API_URL=http://backend:8000 bo'ladi.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
# Kanonik/hreflang manzillari uchun sayt URL'i
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yangi auth oqimi: email+parol (backend JWT), sessiyada rol/onboarding, proxy yo'naltirishlari.
# true bo'lsa akkaunt API'si (profil, onboarding) doim backend'ga boradi, katalog API_MODE bo'yicha.
# Brauzer backend'ga to'g'ridan-to'g'ri emas, /api/backend (BFF) orqali murojaat qiladi.
NEXT_PUBLIC_BACKEND_AUTH=false
# Backend FORWARDED_IP_SECRET bilan bir xil (faqat serverda). Shu bilan backend mijoz IP'sini
# throttle/audit uchun qabul qiladi; bo'sh bo'lsa IP uzatilmaydi. Dev compose: dev-forward-secret
BACKEND_FORWARD_SECRET=
# Frontend oldidagi ishonchli proxy'lar soni (Vercel/nginx — 1); X-Forwarded-For o'ngdan olinadi.
TRUSTED_PROXY_HOPS=1

# --- Auth.js (Google) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (README'ga qarang)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessiya cookie'sini imzolash kaliti: `npx auth secret` yoki `openssl rand -base64 32`
AUTH_SECRET=
# Faqat production'da, proxy ortida host aniqlanmasa (Vercel'da kerak emas):
# AUTH_URL=https://maktab365.uz
