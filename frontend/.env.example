# mock | http  (default: mock)
NEXT_PUBLIC_API_MODE=mock
# Kanonik/hreflang manzillari uchun sayt URL'i
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth.js (Google) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (README'ga qarang)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessiya cookie'sini imzolash kaliti: `npx auth secret` yoki `openssl rand -base64 32`
AUTH_SECRET=
# Faqat production'da, proxy ortida host aniqlanmasa (Vercel'da kerak emas):
# AUTH_URL=https://maktab365.uz
