# mock | http  (default: mock)
NEXT_PUBLIC_API_MODE=mock
# Mavzu materiallari (Xulosa, Taqdimot): backend tayyor bo'lguncha mock; "http" — haqiqiy API (docs/api-mavzu-materiallari.md).
NEXT_PUBLIC_TOPIC_MATERIALS_API=mock
# Backend (Django) manzili: brauzer uchun NEXT_PUBLIC_API_URL, server (SSR) uchun API_URL.
# Docker ichida (frontend ham konteynerda bo'lsa) API_URL=http://backend:8000 bo'ladi.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
# Sayt URL'i (sitemap, robots, canonical/hreflang, JSON-LD). Bo'sh bo'lsa https://www.darslik365.uz.
# Build vaqtida kodga yoziladi: Vercel'da o'zgartirilsa qayta deploy kerak.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (email+parol, Google, Telegram, email kodi) — hammasi backend JWT'lari bilan. Akkaunt API'si
# (profil, onboarding) doim backend'ga boradi, katalog API_MODE bo'yicha. Brauzer backend'ga
# to'g'ridan-to'g'ri emas, /api/backend (BFF) orqali murojaat qiladi.

# Backend FORWARDED_IP_SECRET bilan bir xil (faqat serverda). Shu bilan backend mijoz IP'sini
# throttle/audit uchun qabul qiladi; bo'sh bo'lsa IP uzatilmaydi. Dev compose: dev-forward-secret
BACKEND_FORWARD_SECRET=
# Frontend oldidagi ishonchli proxy'lar soni (Vercel/nginx — 1); X-Forwarded-For o'ngdan olinadi.
TRUSTED_PROXY_HOPS=1

# --- Auth.js (Google) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (README'ga qarang).
# GOOGLE_CLIENT_ID backend `GOOGLE_CLIENT_ID` bilan bir xil bo'lishi shart (id_token `aud`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessiya cookie'sini imzolash kaliti: `npx auth secret` yoki `openssl rand -base64 32`
AUTH_SECRET=
# Faqat production'da, proxy ortida host aniqlanmasa (Vercel'da kerak emas):
# AUTH_URL=https://maktab365.uz

# --- Telegram Login Widget ---
# Bot username (@ belgisiz). @BotFather: /newbot, so'ng /setdomain bilan sayt domenini bog'lang;
# bot tokeni backend `TELEGRAM_BOT_TOKEN` da. Bo'sh bo'lsa Telegram tugmasi ko'rinmaydi.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Botning raqamli id si (token `123456:ABC…` dagi `123456`): maxsus Telegram tugmasi uchun.
NEXT_PUBLIC_TELEGRAM_BOT_ID=
