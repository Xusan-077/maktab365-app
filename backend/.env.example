# Nusxa oling: cp .env.example .env
SECRET_KEY=change-me-dev-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DATABASE_URL=postgres://maktab365:maktab365@localhost:5432/maktab365
REDIS_URL=redis://localhost:6379/0
# Host porti band bo'lsa compose uchun ildizdagi .env: POSTGRES_PORT=55432 (va shu yerda ham 55432).
# CELERY_BROKER_URL=redis://localhost:6379/0

# CORS: frontend origin'lari (vergul bilan)
FRONTEND_ORIGINS=http://localhost:3000
# Prod'da: CSRF_TRUSTED_ORIGINS=https://api.maktab365.uz

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Aylantirilgan refresh shuncha soniya ichida qayta kelsa oila bekor qilinmaydi
REFRESH_REUSE_GRACE_SECONDS=10

# Email havolalari (tasdiqlash, parol tiklash) shu frontend manziliga olib boradi
FRONTEND_URL=http://localhost:3000
# Bo'sh — konsolga chiqaradi (dev). Prod: SMTP yoki Resend SMTP:
# EMAIL_URL=smtp+tls://resend:re_xxx@smtp.resend.com:587
# DEFAULT_FROM_EMAIL=maktab365 <no-reply@maktab365.uz>
# Next serveri bilan umumiy sir (frontend BACKEND_FORWARD_SECRET bilan bir xil) — shundagina
# u uzatgan mijoz IP'siga ishoniladi. Backend o'z proxy'si ortida bo'lsa: TRUSTED_PROXY_HOPS=1
# FORWARDED_IP_SECRET=
# TRUSTED_PROXY_HOPS=0
# Bloklash: ketma-ket N noto'g'ri parol -> S soniya
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_SECONDS=900
# Auth endpoint'larining IP bo'yicha chegarasi (default 10/min); e2e ketma-ket kirishlari uchun oshiring
# AUTH_THROTTLE_RATE=10/min

# Kirish usullari (bo'sh — o'chiq). GOOGLE_CLIENT_ID frontend bilan bir xil.
# GOOGLE_CLIENT_ID=
# @BotFather tokeni (Telegram Login Widget imzosi shu bilan tekshiriladi) va botning domeni /setdomain
# TELEGRAM_BOT_TOKEN=
# Email OTP: kod muddati (daqiqa), urinishlar, qayta so'rash cooldown'i (soniya)
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# Yordam murojaatlari haqida xabar oladigan staff email'lari (vergul bilan)
# SUPPORT_NOTIFY_EMAILS=support@maktab365.uz

# Sentry (bo'sh bo'lsa o'chiq)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Fayl saqlash: bo'sh bo'lsa lokal `media/`. S3-mos saqlash uchun (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ham kerak):
# AWS_STORAGE_BUCKET_NAME=maktab365-media
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=

# Ochiq kontent API: true bo'lsa draft/reviewed mavzular `unverified` belgisi bilan ko'rinadi.
# Default: dev'da true, prod'da false (prod'da yoqish — ongli qaror).
# SHOW_DRAFTS_PUBLICLY=true
# CONTENT_CACHE_MAX_AGE=60

# Railway deploy: DEPLOY.md. Platforma o'zgaruvchilari (RAILWAY_GIT_COMMIT_SHA…) avtomatik, qo'lda berilmaydi.

# Superadmin: `python manage.py create_admin` shu akkauntni admin qiladi/yaratadi (bo'sh bo'lsa xato).
# `ensure_admin` — xuddi shu, lekin bo'sh bo'lsa jim o'tkazib yuboradi (deploy skriptlari uchun).
# Qiymatni faqat o'z `.env` ingizda yoki prod env'da (Railway) bering; kodga/testga/README'ga yozilmaydi.
# Shu juftlik bilan oddiy login formasidan ham kiriladi (env admin: bazada bo'lmasa yaratiladi, o'chirilmaydi,
# bloklanmaydi, roli tushirilmaydi; parol almashsa keyingi kirishda xesh yangilanadi). Ikkalasi ham bo'sh — o'chiq.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# PDF darsliklar (admin yuklaydi). Prod'da S3-mos saqlash (Cloudflare R2) shart: baytlar
# brauzer <-> R2 o'rtasida to'g'ridan-to'g'ri o'tadi (Vercel BFF 4.5 MB cheklovi). Bo'sh bo'lsa lokal `media/`.
# Ixtiyoriy hajm chegarasi (bayt); bo'sh yoki 0 — cheksiz:
# PDF_BOOK_MAX_BYTES=
# Multipart bo'lakning eng kichik hajmi; katta faylda avtomatik kattalashadi (10 000 bo'lakgacha):
# PDF_UPLOAD_PART_BYTES=8388608
# Imzolangan yuklash/o'qish URL'lari muddati (soniya), tavsiya 600–900:
# PDF_SIGNED_URL_SECONDS=900
# PDF_UPLOAD_THROTTLE_RATE=60/hour
# AWS_S3_SIGNATURE_VERSION=s3v4
