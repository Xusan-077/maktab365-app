# Nusxa oling: cp .env.example .env
SECRET_KEY=change-me-dev-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DATABASE_URL=postgres://maktab365:maktab365@localhost:5432/maktab365
REDIS_URL=redis://localhost:6379/0
# Host porti band bo'lsa compose uchun ildizdagi .env: POSTGRES_PORT=55432 (va shu yerda ham 55432).
# CELERY_BROKER_URL=redis://localhost:6379/0

# CORS: frontend origin'lari (vergul bilan)
FRONTEND_ORIGINS=http://localhost:3000
# Prod'da: CSRF_TRUSTED_ORIGINS=https://api.maktab365.uz

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Email havolalari (tasdiqlash, parol tiklash) shu frontend manziliga olib boradi
FRONTEND_URL=http://localhost:3000
# Bo'sh — konsolga chiqaradi (dev). Prod: SMTP yoki Resend SMTP:
# EMAIL_URL=smtp+tls://resend:re_xxx@smtp.resend.com:587
# DEFAULT_FROM_EMAIL=maktab365 <no-reply@maktab365.uz>
# Next serveri bilan umumiy sir (frontend BACKEND_FORWARD_SECRET bilan bir xil) — shundagina
# u uzatgan mijoz IP'siga ishoniladi. Backend o'z proxy'si ortida bo'lsa: TRUSTED_PROXY_HOPS=1
# FORWARDED_IP_SECRET=
# TRUSTED_PROXY_HOPS=0
# Bloklash: ketma-ket N noto'g'ri parol -> S soniya
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_SECONDS=900

# Sentry (bo'sh bo'lsa o'chiq)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
