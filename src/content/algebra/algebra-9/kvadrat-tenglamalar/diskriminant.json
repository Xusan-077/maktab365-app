{
  "status": "draft",
  "order": 3,
  "title": {
    "uz": "Diskriminant va ildizlar",
    "ru": "Дискриминант и корни",
    "en": "Discriminant and roots"
  },
  "blocks": [
    {
      "id": "goal",
      "type": "goal",
      "text": {
        "uz": "Diskriminantni hisoblab, kvadrat tenglamaning nechta ildizi borligini aniqlashni va ildizlarni formula bilan topishni o'rganasiz."
      }
    },
    {
      "id": "explanation-why",
      "type": "explanation",
      "title": {
        "uz": "Nima uchun diskriminant kerak?"
      },
      "text": {
        "uz": "To'liq kvadrat tenglamani (b ham, c ham noldan farqli) har doim ham sinab ko'rib yechib bo'lmaydi. Buning uchun umumiy usul bor: avval D = b² − 4ac sonini hisoblaymiz. U diskriminant deyiladi va ildizlar soni haqida xabar beradi."
      }
    },
    {
      "id": "explanation-cases",
      "type": "explanation",
      "title": {
        "uz": "Diskriminant nimani ko'rsatadi?"
      },
      "text": {
        "uz": "Agar D > 0 bo'lsa, tenglama ikkita turli ildizga ega. Agar D = 0 bo'lsa, bitta ildiz bor (ikkita ildiz bir-biriga teng). Agar D < 0 bo'lsa, haqiqiy ildiz yo'q. Grafikda: parabola x o'qini ikki nuqtada kesadi, unga uchi bilan tegadi yoki umuman kesmaydi."
      }
    },
    {
      "id": "rule-discriminant",
      "type": "rule",
      "title": {
        "uz": "Diskriminant"
      },
      "text": {
        "uz": "D ning ishorasi ildizlar sonini belgilaydi: D > 0 — ikkita, D = 0 — bitta, D < 0 — ildiz yo'q."
      },
      "formula": "D = b^2 - 4ac"
    },
    {
      "id": "rule-roots",
      "type": "rule",
      "title": {
        "uz": "Ildizlar formulasi"
      },
      "text": {
        "uz": "D ≥ 0 bo'lganda tenglamaning ildizlari quyidagi formula bilan topiladi. D = 0 bo'lsa, ± ning ikkala tomoni bir xil son beradi."
      },
      "formula": "x_{1,2} = \\frac{-b \\pm \\sqrt{D}}{2a}"
    },
    {
      "id": "widget-graph",
      "type": "widget",
      "kind": "quadratic-graph",
      "props": {
        "a": 1,
        "b": -2,
        "c": -3
      }
    },
    {
      "id": "example-two-roots",
      "type": "example",
      "title": {
        "uz": "2x² − 5x + 2 = 0 tenglamani yeching"
      },
      "steps": [
        {
          "text": {
            "uz": "Koeffitsiyentlar: a = 2, b = −5, c = 2."
          },
          "formula": "a = 2,\\quad b = -5,\\quad c = 2"
        },
        {
          "text": {
            "uz": "Diskriminantni hisoblaymiz. D > 0, demak ikkita ildiz bor."
          },
          "formula": "D = (-5)^2 - 4 \\cdot 2 \\cdot 2 = 25 - 16 = 9"
        },
        {
          "text": {
            "uz": "Formulaga qo'yamiz."
          },
          "formula": "x_{1,2} = \\frac{5 \\pm 3}{4}"
        },
        {
          "text": {
            "uz": "Javob: x₁ = 2, x₂ = 1/2 (ya'ni 0,5)."
          },
          "formula": "x_1 = 2,\\quad x_2 = \\frac{1}{2}"
        }
      ]
    },
    {
      "id": "example-one-root",
      "type": "example",
      "title": {
        "uz": "x² + 4x + 4 = 0 tenglamani yeching"
      },
      "steps": [
        {
          "text": {
            "uz": "a = 1, b = 4, c = 4. Diskriminant:"
          },
          "formula": "D = 4^2 - 4 \\cdot 1 \\cdot 4 = 0"
        },
        {
          "text": {
            "uz": "D = 0, demak bitta ildiz bor."
          },
          "formula": "x = \\frac{-4}{2 \\cdot 1} = -2"
        },
        {
          "text": {
            "uz": "Javob: x = −2."
          }
        }
      ]
    },
    {
      "id": "example-no-roots",
      "type": "example",
      "title": {
        "uz": "x² + x + 1 = 0 tenglamani yeching"
      },
      "steps": [
        {
          "text": {
            "uz": "a = 1, b = 1, c = 1. Diskriminant:"
          },
          "formula": "D = 1^2 - 4 \\cdot 1 \\cdot 1 = -3"
        },
        {
          "text": {
            "uz": "D < 0, demak tenglamaning haqiqiy ildizi yo'q."
          }
        }
      ]
    },
    {
      "id": "exercise-compute-d",
      "type": "exercise",
      "answerType": "input",
      "question": {
        "uz": "x² − 6x + 5 = 0 tenglamaning diskriminantini toping."
      },
      "answer": ["16"],
      "hint": {
        "uz": "a = 1, b = −6, c = 5. D = b² − 4ac formulasiga qo'ying."
      },
      "explanation": {
        "uz": "D = (−6)² − 4 · 1 · 5 = 36 − 20 = 16."
      }
    },
    {
      "id": "exercise-larger-root",
      "type": "exercise",
      "answerType": "input",
      "question": {
        "uz": "x² − 6x + 5 = 0 tenglamaning katta ildizini toping."
      },
      "answer": ["5"],
      "hint": {
        "uz": "Oldingi mashqda D = 16, √D = 4. Formulada qo'shishni tanlang."
      },
      "explanation": {
        "uz": "x = (6 ± 4)/2: x₁ = 1, x₂ = 5. Katta ildiz — 5."
      }
    },
    {
      "id": "exercise-count",
      "type": "exercise",
      "answerType": "choice",
      "question": {
        "uz": "3x² + 2x + 5 = 0 tenglama nechta haqiqiy ildizga ega?"
      },
      "options": [
        {
          "uz": "ikkita"
        },
        {
          "uz": "bitta"
        },
        {
          "uz": "ildiz yo'q"
        },
        {
          "uz": "uchta"
        }
      ],
      "answer": 2,
      "hint": {
        "uz": "Avval D ni hisoblang: a = 3, b = 2, c = 5."
      },
      "explanation": {
        "uz": "D = 2² − 4 · 3 · 5 = 4 − 60 = −56 < 0, demak haqiqiy ildiz yo'q."
      }
    },
    {
      "id": "exercise-zero-d",
      "type": "exercise",
      "answerType": "truefalse",
      "question": {
        "uz": "D = 0 bo'lsa, kvadrat tenglama ikkita turli ildizga ega."
      },
      "answer": false,
      "hint": {
        "uz": "D = 0 bo'lganda formuladagi √D nimaga teng?"
      },
      "explanation": {
        "uz": "D = 0 da √D = 0, shuning uchun x = −b/(2a): bitta ildiz (ikkita teng ildiz)."
      }
    },
    {
      "id": "summary",
      "type": "summary",
      "points": [
        {
          "uz": "D = b² − 4ac: D > 0 — ikkita ildiz, D = 0 — bitta, D < 0 — haqiqiy ildiz yo'q."
        },
        {
          "uz": "Ildizlar: x = (−b ± √D) / (2a), faqat D ≥ 0 bo'lganda."
        },
        {
          "uz": "Parabola x o'qini kesishi ildizlar soniga mos keladi."
        }
      ]
    }
  ]
}
